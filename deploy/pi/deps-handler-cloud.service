# The App's server, on the Pi. Settings and keys in
# /etc/deps-handler-cloud/prod.env; its database and checkouts in
# /var/lib/deps-handler-cloud. Installed by scripts/deploy-pi.sh.
[Unit]
Description=deps-handler GitHub App
Wants=network-online.target
After=network-online.target

[Service]
User=dmc
Group=dmc
EnvironmentFile=/etc/deps-handler-cloud/prod.env
Environment=HOME=/var/lib/deps-handler-cloud
ExecStart=/opt/deps-handler-cloud/server
Restart=on-failure
RestartSec=5
StateDirectory=deps-handler-cloud
StateDirectoryMode=0700
MemoryMax=768M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
