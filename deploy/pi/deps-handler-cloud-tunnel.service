# The App's Cloudflare named tunnel, to the server on 127.0.0.1. Its
# config and credentials are in /etc/deps-handler-cloud.
[Unit]
Description=deps-handler GitHub App tunnel
Wants=network-online.target
After=network-online.target deps-handler-cloud.service

[Service]
User=dmc
Group=dmc
ExecStart=/opt/deps-handler-cloud/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20251 --config /etc/deps-handler-cloud/cloudflared.yml run
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
